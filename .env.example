# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed.

# --- AI provider (Google Gemini) ---
# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Render service ---
# Base URL embedded in returned download links. For a local run leave as-is;
# for a remote (ChatGPT/Claude) demo set this to your public tunnel URL.
PUBLIC_BASE_URL=http://localhost:4000

# --- Images (optional) ---
# Free Pexels API key for slide photos: https://www.pexels.com/api/
# If unset, decks render with clean typography (no photos) — everything still works.
PEXELS_API_KEY=
